{
	"name": "@dsmrt/axiom-cli",
	"version": "1.3.10",
	"description": "axiom cli for managing configs including secrets",
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"repository": {
		"type": "git",
		"url": "git@github.com:dsmrt/axiom.git",
		"directory": "cli"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"bin": {
		"axiom": "dist/bin/axiom.mjs"
	},
	"scripts": {
		"lint": "biome lint",
		"lint:fix": "biome lint --fix",
		"test": "vitest run --coverage",
		"watch": "vitest watch --coverage",
		"build": "tsup --entry ./src/bin/axiom.ts --entry ./src/index.ts --format cjs,esm --dts --clean",
		"release": "pnpm run build && pnpm changeset publish"
	},
	"keywords": [
		"axiom",
		"config",
		"aws",
		"cli"
	],
	"author": {
		"name": "Damien Smrt",
		"url": "https://dsmrt.com"
	},
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@changesets/cli": "^3.0.2",
		"@types/inquirer": "^8.2.10",
		"@types/node": "^26.5.0",
		"@types/yargs": "^17.0.35",
		"@vitest/coverage-v8": "^5.0.0",
		"aws-sdk-client-mock": "^4.1.0",
		"ts-node": "^10.9.2",
		"tsup": "^8.5.1",
		"typescript": "^5.7.2",
		"vitest": "^5.0.0"
	},
	"dependencies": {
		"@aws-sdk/client-ssm": "^3.1127.0",
		"@aws-sdk/client-sts": "^3.1127.0",
		"@aws-sdk/credential-providers": "^3.1127.0",
		"@aws-sdk/types": "^3.974.5",
		"@dsmrt/axiom-aws-sdk": "workspace:^",
		"@dsmrt/axiom-config": "workspace:^",
		"chalk": "^4.1.2",
		"inquirer": "^14.2.2",
		"yargs": "^18.1.0"
	}
}
